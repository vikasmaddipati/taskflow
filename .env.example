# ===============================================
# TaskFlow Server Environment Configuration
# ===============================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/taskmanager

JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@taskflow.dev
FROM_NAME=TaskFlow Security

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_BUSINESS_MONTHLY=price_business_monthly_id
