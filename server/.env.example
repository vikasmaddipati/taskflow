# ===============================================
# TaskFlow Server Environment Configuration
# ===============================================

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/taskmanager

# JWT Authentication Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# -----------------------------------------------
# Google Authentication (Google Identity Services)
# -----------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -----------------------------------------------
# Email Delivery (SMTP Configuration)
# -----------------------------------------------
# Examples:
# Gmail: host=smtp.gmail.com, port=587, user=your-email@gmail.com, pass=your-app-password
# SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=your-sendgrid-api-key
# Resend: host=smtp.resend.com, port=587, user=resend, pass=your-resend-api-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@taskflow.dev
FROM_NAME=TaskFlow Security
